# Added to the X6100's U-Boot defconfig (AetherX6100Buildroot) for the multiboot menu
CONFIG_VIDEO_LCD_ST7701S_X6100=y
CONFIG_CONSOLE_ROTATION=y
CONFIG_VIDEO_SUNXI_ROTATION=3
# CONFIG_VIDEO_FONT_8X16 is not set
CONFIG_VIDEO_FONT_16X32=y
CONFIG_CMD_GPIO=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_SLEEP=y
CONFIG_BOOTDELAY=0
# CONFIG_TOOLS_MKEFICAPSULE is not set
CONFIG_VIDEO_ANSI=y
CONFIG_CMD_BMP=y
CONFIG_BMP_24BPP=y
