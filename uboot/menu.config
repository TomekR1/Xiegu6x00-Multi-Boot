# Added to the X6100's U-Boot defconfig (AetherX6100Buildroot) for the multiboot menu
CONFIG_VIDEO_LCD_ST7701S_X6100=y
CONFIG_CONSOLE_ROTATION=y
CONFIG_VIDEO_SUNXI_ROTATION=3
# CONFIG_VIDEO_FONT_8X16 is not set
CONFIG_VIDEO_FONT_16X32=y
CONFIG_CMD_GPIO=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_SLEEP=y
CONFIG_BOOTDELAY=0
# CONFIG_TOOLS_MKEFICAPSULE is not set
CONFIG_VIDEO_ANSI=y
CONFIG_CMD_BMP=y
CONFIG_BMP_24BPP=y
# The menu's own script first (MENU/MENU.SCR): a system that writes its own boot.scr on the card
# (IU1WXY 0.2.4+, x6100-sysupdate bootscr) cannot take the menu's place; boot.scr as before without it
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="if load mmc 0:1 ${scriptaddr} MENU/MENU.SCR; then source ${scriptaddr}; fi; run distro_bootcmd"
# IU1WXY 0.2.4+'s boot script keeps its A/B state on the boot FAT: fatwrite and mv
CONFIG_FAT_WRITE=y
CONFIG_CMD_FS_GENERIC=y
