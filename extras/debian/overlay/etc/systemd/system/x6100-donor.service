[Unit]
Description=Kernel modules from the system lending the kernel
DefaultDependencies=no
After=systemd-remount-fs.service
Before=systemd-udevd.service systemd-udev-trigger.service systemd-modules-load.service sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/x6100/donor-mount

[Install]
WantedBy=sysinit.target
